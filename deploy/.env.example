# Copy to deploy/.env on the VPS (never commit the real file). Values override appsettings.json.

# API key for voidlog (header X-Api-Key). Generate with: openssl rand -hex 32
# ServiceClients__ApiKeys__voidlog=

# Where the data lives on the host (default: the folder "data" next to "deploy", e.g. /home/deploy/apps/breakbar-logs/data)
# BREAKBAR_DATA=/home/deploy/apps/breakbar-logs/data

# Optional tuning, see backend/src/Breakbar.Api/appsettings.json
# Retention__MaxReportsBytes=64424509440
# Queue__MaxParallel=2

<Project>
  <!-- Shared settings for all breakbar projects (does not affect the EI submodule). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- Workstation GC with DATAS keeps the memory footprint small on the 4 GB VPS -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <PropertyGroup>
    <EliteInsightsRoot>$(MSBuildThisFileDirectory)..\external\GW2-Elite-Insights-Parser\</EliteInsightsRoot>
  </PropertyGroup>
</Project>
